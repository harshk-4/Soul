# Official public configuration
NEXT_PUBLIC_SITE_URL=https://www.soulfuli.org
SOULFULI_CONTACT_EMAIL=connect@soulfuli.org
# Official WhatsApp Channel URL
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/0029VbDmzH90VycEedVzB92X

# Transactional Email Delivery (Resend) — Required for enquiry & newsletter delivery
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Soulfuli <onboarding@resend.dev>

# Optional: Supabase Server Persistence (Server-only, never expose SERVICE_ROLE in client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Webhook fallback if not using Resend/Supabase directly
ENQUIRY_WEBHOOK_URL=

# Google Form & Sheets Automation for Quiet Bloom Retreat
# Client Google Form endpoint (used by default if omitted):
GOOGLE_FORM_RETREAT_URL=https://docs.google.com/forms/d/e/1FAIpQLSf9T4EK78MCKn26Wzabu-PfdLgJUrrhJc_bLaC3cbMl5wQU3Q/formResponse
# Optional: Google Apps Script Web App URL for direct Google Sheets recording & Gmail automation
GOOGLE_SCRIPT_URL=

